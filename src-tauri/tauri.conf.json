{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elephant Stack",
  "version": "0.1.0",
  "identifier": "com.cristiancosano.elephant-stack",
  "build": {
    "beforeDevCommand": "./scripts/build-sidecars.sh debug && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "./scripts/build-sidecars.sh release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Elephant Stack",
        "width": 920,
        "height": 600,
        "minWidth": 760,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "trafficLightPosition": { "x": 18, "y": 20 },
        "windowEffects": { "effects": ["sidebar"], "state": "followsWindowActiveState" }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/cli", "binaries/php-selector"]
  }
}
